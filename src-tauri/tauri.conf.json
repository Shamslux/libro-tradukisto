
{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Libro Tradukisto",
  "version": "0.1.2",
  "identifier": "io.github.shamslux.librotradukisto",
  "build": {
    "frontendDist": "../src-ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Libro Tradukisto",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR",
          "English",
          "Spanish",
          "French",
          "German",
          "Russian",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwQ0JGNDAxQjdFQUZGMDIKUldRQy8rcTNBZlRMb0dwRnluTUR4bEVkamFmcWlmdElFMFdxekh3V25HQjFHZWprd1YvYXRtNEUK",
      "endpoints": [
        "https://github.com/Shamslux/libro-tradukisto/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
